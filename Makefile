# Developer and operator entrypoints.
#
# Every target is documented in README.md. Secrets are never passed on the
# command line: they come from the environment file.

SHELL := /bin/bash
PYTHON ?= .venv/bin/python
PIP ?= .venv/bin/pip
# Development builds the image from the working tree and adds the dev
# overrides. Production uses compose.yaml alone and the published image.
COMPOSE_DEV ?= docker compose -f compose.yaml -f compose.dev.yaml
COMPOSE_PROD ?= docker compose -f compose.yaml

.DEFAULT_GOAL := help

.PHONY: help
help: ## Show this help
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) \
		| awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-24s\033[0m %s\n", $$1, $$2}'

.PHONY: venv
venv: ## Create the local virtual environment
	python3.13 -m venv .venv
	$(PIP) install --upgrade pip

.PHONY: install
install: ## Install runtime and development dependencies
	PIP_USER=0 $(PIP) install -r requirements-dev.lock

.PHONY: lock
lock: ## Recompile the dependency lock files
	PIP_USER=0 .venv/bin/pip-compile --quiet --strip-extras --output-file=requirements.lock pyproject.toml
	PIP_USER=0 .venv/bin/pip-compile --quiet --strip-extras --extra=dev --output-file=requirements-dev.lock pyproject.toml

.PHONY: format
format: ## Apply the formatter
	.venv/bin/ruff format app tests alembic scripts

.PHONY: format-check
format-check: ## Verify formatting
	.venv/bin/ruff format --check app tests alembic scripts

.PHONY: lint
lint: ## Run the linter
	.venv/bin/ruff check app tests alembic scripts

.PHONY: typecheck
typecheck: ## Run the static type checker
	.venv/bin/mypy app tests

.PHONY: test
test: ## Run the whole test suite
	$(PYTHON) -m pytest

.PHONY: test-unit
test-unit: ## Run unit, contract and security tests only
	$(PYTHON) -m pytest tests/unit tests/contract tests/security

.PHONY: test-integration
test-integration: ## Run integration tests against a disposable MySQL
	$(PYTHON) -m pytest tests/integration

.PHONY: coverage
coverage: ## Run the suite with coverage and enforce the documented threshold
	$(PYTHON) -m pytest --cov=app --cov-report=term-missing --cov-fail-under=70

.PHONY: audit
audit: ## Run the repository audits (buttons, secrets, placeholders)
	$(PYTHON) scripts/handler_audit.py
	bash scripts/secret_scan.sh
	bash scripts/placeholder_scan.sh

.PHONY: audit-ci
audit-ci: ## Run the repository audits in a CI-identical Linux container
	@docker run --rm -v "$(CURDIR):/repo:ro" ubuntu:24.04 bash -c '\
		apt-get update -qq >/dev/null && apt-get install -y -qq git >/dev/null; \
		cp -r /repo /tmp/work && cd /tmp/work; \
		git config --global --add safe.directory /tmp/work; \
		bash scripts/secret_scan.sh && bash scripts/placeholder_scan.sh'

.PHONY: verify
verify: format-check lint typecheck test audit ## Run every local quality gate

.PHONY: verify-ci
verify-ci: verify audit-ci ## Everything CI runs, including the Linux-only audits

.PHONY: migrate
migrate: ## Apply migrations locally
	$(PYTHON) -m app.cli migrate

.PHONY: revision
revision: ## Create a new autogenerated migration (usage: make revision m="message")
	.venv/bin/alembic revision --autogenerate -m "$(m)"

.PHONY: build
build: ## Build the application image
	$(COMPOSE_DEV) build

.PHONY: config
config: ## Validate the Compose configuration
	$(COMPOSE_PROD) config >/dev/null && echo "compose configuration is valid"

.PHONY: up
up: ## Start the stack (migrations run first, as a dependency)
	$(COMPOSE_DEV) up -d

.PHONY: down
down: ## Stop the stack, keeping the data volume
	$(COMPOSE_DEV) down

.PHONY: logs
logs: ## Tail the application logs
	$(COMPOSE_DEV) logs --tail=200 -f bot worker

.PHONY: ps
ps: ## Show the container status
	$(COMPOSE_DEV) ps

.PHONY: backup
backup: ## Run the encrypted backup job once
	$(COMPOSE_DEV) --profile backup run --rm backup

.PHONY: keys
keys: ## Generate fresh secrets for a new environment
	$(PYTHON) scripts/generate_keys.py

.PHONY: clean
clean: ## Remove caches and build artefacts
	rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov .coverage
	find . -name '__pycache__' -type d -prune -exec rm -rf {} +
