# Copy to .env and fill in locally or on the server. Never commit .env.
# Generate every secret with: make keys

# Deployment
# Published image to run. Leave the defaults unless you are pinning a rollback
# to an exact commit, which the pipeline also tags as sha-<commit>.
OPBG_IMAGE=ghcr.io/lucatomei/opbg-telegram-bot
OPBG_TAG=latest

# Application
APP_ENV=production
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Rome
# 32+ bytes of base64 (url-safe) material. Generate with `make keys`.
# APP_SECRET_KEY peppers the hashes of invite codes and confirmation nonces:
# without it a database leak alone cannot verify a guessed code. Changing it
# invalidates every code already issued.
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
# Rotation only: comma separated "version:key" pairs still needed to decrypt.
APP_PREVIOUS_ENCRYPTION_KEYS=
# Separate key, derived independently, used only for blind indexes.
APP_BLIND_INDEX_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=123456789

# MySQL 8.4
MYSQL_DATABASE=opbg_bot
MYSQL_USER=opbg_bot
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Portal
PORTAL_BASE_URL=https://prenotazioni.ospedalebambinogesu.it
PORTAL_TIMEOUT_SECONDS=30
PORTAL_SLOW_TIMEOUT_SECONDS=90
PORTAL_OPERATION_BUDGET_SECONDS=90
PORTAL_MAX_CONCURRENCY=2
PORTAL_USER_AGENT=OPBG-Booking-Assistant/1.0
PORTAL_MIN_INTERVAL_MS=800
PORTAL_MAX_RETRIES=3

# Monitoring
MONITOR_DEFAULT_INTERVAL_SECONDS=300
MONITOR_MIN_INTERVAL_SECONDS=120
MONITOR_JITTER_SECONDS=30
MONITOR_ERROR_BACKOFF_MAX_SECONDS=3600
MONITOR_LEASE_SECONDS=180
MONITOR_BATCH_SIZE=10
MAX_PORTAL_ACCOUNTS_PER_USER=10
MAX_ACTIVE_MONITORS_PER_ACCOUNT=20
APPOINTMENT_SYNC_INTERVAL_SECONDS=3600

# Ripristino automatico degli account
# Un account rifiutato dal portale riprova da solo le credenziali salvate, a
# intervalli distanziati. Non e' un loop di password: ogni rifiuto vero conta
# comunque verso il blocco che passa la palla a una persona.
ACCOUNT_RECOVERY_ENABLED=true
ACCOUNT_RECOVERY_DELAY_SECONDS=900
ACCOUNT_RECOVERY_BATCH_SIZE=5

# Circuit breaker
BREAKER_ACCOUNT_FAILURE_THRESHOLD=5
BREAKER_ACCOUNT_COOLDOWN_SECONDS=900
BREAKER_GLOBAL_FAILURE_THRESHOLD=20
BREAKER_GLOBAL_COOLDOWN_SECONDS=600

# Security and lifecycle
INVITE_TTL_HOURS=72
DESTRUCTIVE_CONFIRMATION_TTL_SECONDS=120
CONVERSATION_STATE_TTL_SECONDS=3600
BOOKING_DRAFT_TTL_SECONDS=3600
PDF_MAX_BYTES=10485760
AUDIT_RETENTION_DAYS=365
EVENT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
SEEN_SLOT_RETENTION_DAYS=30
APPOINTMENT_RETENTION_DAYS=365
CONNECT_RATE_LIMIT_PER_HOUR=10
CONNECT_MAX_FAILURES=5
CONSENT_VERSION=1.0

# Presentation
PAGE_SIZE=6
MAX_SLOTS_SHOWN=40

# Worker
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_SECONDS=30
WORKER_HEARTBEAT_STALE_SECONDS=120


# Backup (profile "backup")
BACKUP_RETENTION_DAYS=14
# Mount a secret file, or set the passphrase for a one-off run. Store it away
# from the archives: a backup and its key must never live in the same place.
BACKUP_PASSPHRASE_FILE=/run/secrets/backup_passphrase
BACKUP_PASSPHRASE=
